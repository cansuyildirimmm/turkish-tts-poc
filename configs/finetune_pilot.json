{
  "run_name": "pilot_sft",
  "init": "models/freya-tts",
  "data_dir": "datasets/pilot/latents",
  "output_dir": "checkpoints",
  "seed": 42,

  "steps": 1500,
  "batch_size": 16,
  "grad_accum": 1,
  "lr": 5e-05,
  "warmup": 100,
  "betas": [0.9, 0.95],
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "lambda_dur": 0.1,
  "max_frames": 500,
  "precision": "bf16",

  "log_every": 10,
  "val_every": 50,
  "ckpt_every": 250,
  "keep_last": 3,
  "early_stopping": {"patience": 6, "min_delta": 0.0}
}
